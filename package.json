{
  "name": "@lockally/react-native",
  "version": "0.1.0",
  "description": "Official Lockally SDK for React Native — transactional email, contacts, and agent inboxes. Secure-by-default auth (backend-minted tokens + OAuth PKCE) over the typed `lockally` client.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": { "type": "git", "url": "https://github.com/LockallyInc/lockally-react-native.git" },
  "homepage": "https://lockally.com",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "test": "node --test",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "lockally": "^0.1.0"
  },
  "peerDependencies": {
    "react-native": ">=0.72",
    "expo-auth-session": "*",
    "expo-secure-store": "*",
    "expo-crypto": "*"
  },
  "peerDependenciesMeta": {
    "expo-auth-session": { "optional": true },
    "expo-secure-store": { "optional": true },
    "expo-crypto": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
